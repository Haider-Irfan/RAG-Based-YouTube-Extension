{
  "manifest_version": 3,
  "name": "YouTube RAG Assistant",
  "version": "1.0",
  "description": "Ask questions about YouTube videos",
  "permissions": ["activeTab", "scripting", "tabs"],
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "action": {
    "default_popup": "ext.html",
    "default_icon": "icon.png"
  }
}
